root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.java]
# --- K&Rスタイル　---
ij_java_class_brace_style = end_of_line
ij_java_method_brace_style = end_of_line
ij_java_block_brace_style = end_of_line

# --- 1行で済むifに｛｝を付けない ---
ij_java_if_brace_force = never
ij_java_for_brace_force = if_multiline
ij_java_while_brace_force = if_multiline
ij_java_do_while_brace_force = if_multiline
ij_java_keep_control_statement_in_one_line = true

# --- import整理 ---
ij_java_imports_layout = *,javax.**,java.**, | ,$*
ij_java_use_single_class_imports = true
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_delete_unused_module_imports = true

# --- いらない空行の整理（基本的に2行開けない）---
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_in_declarations = 1
ij_java_keep_blank_lines_between_package_declaration_and_header = 1
ij_java_keep_blank_lines_before_right_brace = 0
ij_java_blank_lines_after_imports = 1
