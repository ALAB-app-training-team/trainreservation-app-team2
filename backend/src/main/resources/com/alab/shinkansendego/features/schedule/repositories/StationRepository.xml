<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis/org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alab.shinkansendego.features.schedule.repositories.StationRepository">
    <select id="findAllStationList" resultType="com.alab.shinkansendego.features.schedule.dtos.StationResponseDto">
        SELECT station_cd,name
        FROM M_Station;
    </select>
    <select id="findStationCdByName" resultType="String" parameterType="String">
        SELECT station_cd
        FROM M_Station
        WHERE name=#{name};
    </select>
</mapper>
