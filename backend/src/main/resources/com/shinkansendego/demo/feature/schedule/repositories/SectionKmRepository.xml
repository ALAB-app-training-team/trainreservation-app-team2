<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis/org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shinkansendego.demo.feature.schedule.repositories.SectionKmRepository">
    <select id="findSectionCdByStartStationCd" resultType="String" parameterType="String">
        SELECT section_cd
        FROM M_SectionKm
        WHERE start_station_cd=#{start_station_cd};
    </select>
    <select id="findSectionCdByGoalStationCd" resultType="String" parameterType="String">
        SELECT section_cd
        FROM M_SectionKm
        WHERE goal_station_cd=#{goal_station_cd};
    </select>
</mapper>
