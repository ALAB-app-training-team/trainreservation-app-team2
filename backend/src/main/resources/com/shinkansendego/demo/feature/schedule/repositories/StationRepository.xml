<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis/org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shinkansendego.demo.feature.schedule.repositories.StationRepository">
    <select id="findStationCdByName" resultType="String" parameterType="String">
        SELECT station_cd
        FROM M_Station
        WHERE name=#{name};
    </select>
</mapper>
